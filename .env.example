# ── TerminalPro Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in your keys before running docker-compose

# Finnhub API — FREE tier: 60 req/min, global stocks, OHLCV, fundamentals
# Sign up: https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep — FREE tier: 250 req/day, income/balance/cashflow
# Sign up: https://financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key_here

# Anthropic — for AI analysis (Analysis page) and news sentiment
# Sign up: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
