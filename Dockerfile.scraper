# ── Python scraper (FastAPI + Scrapling + Playwright) ─────────────────────────
FROM python:3.11-slim AS runtime
WORKDIR /app

# Install pip explicitly + all system deps Playwright needs in one layer
# keeping apt lists intact until after playwright --with-deps runs
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    curl \
    # Playwright Chromium deps
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    # libasound2 renamed to libasound2t64 in Debian 12 / Ubuntu 24 — try both
    && (apt-get install -y --no-install-recommends libasound2t64 || \
        apt-get install -y --no-install-recommends libasound2 || true) \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY src/TerminalPro.Scraper/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright browser — must happen AFTER pip installs playwright package
# --with-deps handles its own apt install so keep this separate
RUN pip show playwright > /dev/null 2>&1 \
 && python -m playwright install chromium \
 && python -m playwright install-deps chromium

COPY src/TerminalPro.Scraper/ ./

# Non-root user
RUN groupadd --system scraper \
 && useradd --system --gid scraper --no-create-home scraper
USER scraper

EXPOSE 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
