# ── Python scraper (FastAPI + Scrapling + Playwright) ─────────────────────────
FROM python:3.11-slim AS runtime
WORKDIR /app

# Install system dependencies required by Playwright's Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libglib2.0-0 libnss3 libnspr4 libdbus-1-3 \
    libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libasound2 \
 && rm -rf /var/lib/apt/lists/*

COPY src/TerminalPro.Scraper/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
 && playwright install chromium --with-deps

COPY src/TerminalPro.Scraper/ ./

# Non-root user
RUN groupadd --system scraper \
 && useradd  --system --gid scraper --no-create-home scraper
USER scraper

EXPOSE 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
